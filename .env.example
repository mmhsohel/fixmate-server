PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=fixmate
# Must be IDENTICAL to JWT_SECRET in client/.env.local
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:3000
# Optional: URL the server uses to reach the Next.js app (docker). Defaults to CLIENT_URL
CLIENT_INTERNAL_URL=
# Comma separated list of allowed browser origins (add your production domain)
CORS_ORIGINS=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IMGBB_API_KEY=
# Seed demo data on boot (idempotent)
SEED_ON_START=true
